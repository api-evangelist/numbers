  "info": {
    "_postman_id": "4070221a-ff01-4146-9ac0-64534cbb0108",
    "name": "Numbers Batch Math API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Numbers API by David Hu and Mack Duan — a free, community-contributed HTTP API for interesting facts about numbers. Returns trivia, math, date, and year facts as plain text or JSON. Supports random numbers, batches/ranges, JSONP callbacks, document.write embedding, sentence-fragment responses, and configurable not-found behavior.\n\nContact Support:\n Name: Numbers API\n Email: numbersapi@gmail.com",
      "type": "text/plain"
    }
