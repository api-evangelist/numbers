      "item": [
        {
          "id": "b28d6595-779e-4867-8b0c-4bc8303ba4a1",
          "name": "Numbers API Get Trivia Fact",
          "request": {
            "name": "Numbers API Get Trivia Fact",
            "description": {
              "content": "Return a trivia fact about the supplied integer. This is the default endpoint when no `type` segment is given. Use the keyword `random` to receive a random trivia fact.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":number"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "json",
                  "value": "<boolean>",
                  "description": "Return the fact as a JSON object (`{ text, found, number, type, date?, year? }`) instead of plain text. Equivalent to setting the request `Content-Type: application/json` header."
                },
                {
                  "disabled": false,
                  "key": "fragment",
                  "value": "<boolean>",
                  "description": "Return the fact as a sentence fragment (lowercase, no terminal punctuation) suitable for embedding in a larger sentence."
                },
                {
                  "disabled": false,
                  "key": "notfound",
                  "value": "default",
                  "description": "Behavior when no fact exists for the requested number. `default` returns a generic message (overridable with `default`), `floor` rounds down to the nearest number with a fact, and `ceil` rounds up."
                },
                {
                  "disabled": false,
                  "key": "default",
                  "value": "<string>",
                  "description": "Custom message to return when no fact exists for the requested number."
                },
                {
                  "disabled": false,
                  "key": "min",
                  "value": "<integer>",
                  "description": "Minimum value (inclusive) for random-number selection. Only meaningful when `number=random`."
                },
                {
                  "disabled": false,
                  "key": "max",
                  "value": "<integer>",
                  "description": "Maximum value (inclusive) for random-number selection. Only meaningful when `number=random`."
                },
                {
                  "disabled": false,
                  "key": "callback",
                  "value": "<string>",
                  "description": "JSONP callback function name. The response is wrapped as `<callback>(\"<fact>\")`."
                },
                {
                  "disabled": false,
                  "key": "write",
                  "value": "<boolean>",
                  "description": "Wrap the response in `document.write(\"<fact>\")` so a single `<script src=\"...\">` tag can render the fact inline. Equivalent to `callback=document.write`."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "number",
                  "description": "(Required) Integer to look up, or the keyword `random` to receive a random available fact."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
