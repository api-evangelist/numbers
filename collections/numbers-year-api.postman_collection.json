      "name": "Year",
      "description": {
        "content": "Historical facts associated with a year.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b1e9cb88-ec01-4608-b4d5-5ff59bf0866b",
          "name": "Numbers API Get Random Year Fact",
          "request": {
            "name": "Numbers API Get Random Year Fact",
            "description": {
              "content": "Return a random year fact (a fact tied to a calendar year). The response includes the year as `number` and, when applicable, an associated `date` string.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "random",
                "year"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "json",
                  "value": "<boolean>",
                  "description": "Return the fact as a JSON object (`{ text, found, number, type, date?, year? }`) instead of plain text. Equivalent to setting the request `Content-Type: application/json` header."
                },
                {
                  "disabled": false,
                  "key": "fragment",
                  "value": "<boolean>",
                  "description": "Return the fact as a sentence fragment (lowercase, no terminal punctuation) suitable for embedding in a larger sentence."
                },
                {
                  "disabled": false,
                  "key": "notfound",
                  "value": "default",
                  "description": "Behavior when no fact exists for the requested number. `default` returns a generic message (overridable with `default`), `floor` rounds down to the nearest number with a fact, and `ceil` rounds up."
                },
                {
                  "disabled": false,
                  "key": "default",
                  "value": "<string>",
                  "description": "Custom message to return when no fact exists for the requested number."
                },
                {
                  "disabled": false,
                  "key": "callback",
                  "value": "<string>",
                  "description": "JSONP callback function name. The response is wrapped as `<callback>(\"<fact>\")`."
                },
                {
                  "disabled": false,
                  "key": "write",
                  "value": "<boolean>",
                  "description": "Wrap the response in `document.write(\"<fact>\")` so a single `<script src=\"...\">` tag can render the fact inline. Equivalent to `callback=document.write`."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "337f9c5c-66ee-427e-ad09-6a20eb685305",
              "name": "Random year fact.",
              "originalRequest": {
                "url": {
                  "path": [
                    "random",
                    "year"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "json",
                      "value": "true"
                    },
                    {
                      "key": "fragment",
                      "value": "true"
                    },
                    {
                      "key": "notfound",
                      "value": "floor"
                    },
                    {
                      "key": "default",
                      "value": "Boring number is boring."
                    },
                    {
                      "key": "callback",
                      "value": "showNumber"
                    },
                    {
                      "key": "write",
                      "value": "true"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "text/plain"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"text\": \"2012 is the year that the century's second and last solar transit of Venus occurs on June 6.\",\n  \"found\": true,\n  \"number\": 2012,\n  \"type\": \"year\",\n  \"date\": \"June 6\"\n}",
              "cookie": [],
